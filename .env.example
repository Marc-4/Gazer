# Supabase (browser + server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key

# Server-only key used by admin user management and booking invitations.
# Without it, booking invitations fall back to Supabase magic links.
# Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct/session-pooler Postgres connection used by the email outbox worker
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# SMTP email (defaults target Brevo's SMTP relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false

# Brevo SMTP credentials
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Generic SMTP alternatives to the Brevo names above
# SMTP_USER=
# SMTP_PASS=

EMAIL_FROM=bookings@your-domain.com
EMAIL_FROM_NAME=School Activity Booking System

# Public app URL used in email links and Supabase invite/reset redirects
APP_URL=http://localhost:3000

# Optional: allow cron/workers to POST /api/notifications/dispatch
NOTIFICATION_WORKER_SECRET=
